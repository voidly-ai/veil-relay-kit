# Your relay's public URL (required for federation; leave unset to run standalone)
RELAY_URL=
# Shared secret for federating with a primary relay (optional — get one by
# registering as a peer; leave unset to run fully independent)
RELAY_PEER_SECRET=
# Primary relay to federate with (optional)
PRIMARY_RELAY=https://api.voidly.ai
# Where message data lives (SQLite)
DATA_DIR=./data
